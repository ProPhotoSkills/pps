    {
      "@type": "Question",
      "name": "Was ist ProPhotoSkills?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ProPhotoSkills ist kein klassischer Fotokurs, sondern ein System für professionelle Bildproduktion – von Denken, Planung und Kommunikation bis zur Umsetzung am Set."
      }
    },

    {
      "@type": "Question",
      "name": "Womit beginnt professionelle Fotografie wirklich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nicht mit der Kamera, sondern mit dem Kopf. Jedes starke Bild beginnt mit einer Entscheidung, bevor der erste Klick passiert."
      }
    },

    {
      "@type": "Question",
      "name": "Warum passieren 70 % des Fotojobs vor dem ersten Klick?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Weil Vorbereitung, Konzept und Entscheidungen den größten Teil des Ergebnisses bestimmen – nicht der Moment des Auslösens."
      }
    },

    {
      "@type": "Question",
      "name": "Ist Fotografie Talent oder trainierbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fotografie ist trainierbar. Skills entstehen durch Wiederholung, Erfahrung und bewusste Entwicklung."
      }
    },

    {
      "@type": "Question",
      "name": "Warum reicht Technik allein nicht aus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Technik erzeugt Qualität – aber Haltung, Kommunikation und Führung entscheiden über die Wirkung eines Bildes."
      }
    },

    {
      "@type": "Question",
      "name": "Macht besseres Equipment bessere Fotos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Equipment verstärkt dein Können – es ersetzt es nicht."
      }
    },

    {
      "@type": "Question",
      "name": "Welche Rolle spielt das Team bei einem Shooting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ein starkes Team beeinflusst Energie, Vertrauen und Ergebnis oft stärker als Technik."
      }
    },

    {
      "@type": "Question",
      "name": "Warum ist Kommunikation so wichtig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Weil Atmosphäre und Vertrauen direkt sichtbar im Bild werden – Kommunikation ist ein zentrales Werkzeug am Set."
      }
    },

    {
      "@type": "Question",
      "name": "Warum ist Planung entscheidend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gute Bilder entstehen selten spontan – sondern durch Vorbereitung, Struktur und klare Entscheidungen."
      }
    },

    {
      "@type": "Question",
      "name": "Warum ist Fotografie ein Investment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Weil Bilder Marken aufbauen, Vertrauen schaffen und langfristig wirken – weit über den Moment der Aufnahme hinaus."
      }
    },

    {
      "@type": "Question",
      "name": "Wie wichtig ist die richtige Location?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eine Location beeinflusst Licht, Raumwirkung und Stimmung – oft stärker als die Kamera selbst."
      }
    },

    {
      "@type": "Question",
      "name": "Warum ist Vorbereitung bei Reisen so wichtig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Weil Logistik entscheidet, ob du ruhig, fokussiert und souverän arbeiten kannst."
      }
    },

    {
      "@type": "Question",
      "name": "Warum ist Absicherung Teil professioneller Fotografie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sicherheit ermöglicht kreative Freiheit und klare Entscheidungen – technisch, rechtlich und organisatorisch."
      }
    }

  ]
